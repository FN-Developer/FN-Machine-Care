{
  "rules": {
    ".read": false,
    ".write": false,

    "records": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$recordId": {
        ".validate": "newData.hasChildren(['id', 'type', 'docNo'])",
        "id": { ".validate": "newData.val() === $recordId" }
      }
    },

    "people": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
