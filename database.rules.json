{
  "rules": {
    ".read": false,
    ".write": false,

    "records": {
      ".read": "auth != null",

      // No write on the collection itself, only on a record inside it.
      // That is what stops one call from deleting the whole service
      // history: a wipe would need one delete per record, not a single
      // PUT of null. The app only ever updates records/<id> paths.
      ".write": false,

      "$recordId": {
        ".write": "auth != null",

        // A record must carry its own identity. That is all the server
        // checks — it is deliberately NOT the place to decide which of
        // two edits is newer.
        //
        // An earlier version also refused any write whose updatedAt was
        // older than the stored one. It read well ("a record may only
        // move forward in time") but it depended on every tablet's CLOCK
        // agreeing. A tablet running even a little slow would have its
        // saves rejected — silently, with the sync badge still green —
        // and the technician saw "saved" while nothing reached the
        // database. Which edit wins is now settled only on the devices,
        // by updatedAt, where a wrong answer costs one overwrite rather
        // than a tablet that can never save at all.
        ".validate": "newData.hasChildren(['id', 'type', 'docNo'])",

        "id": { ".validate": "newData.val() === $recordId" }
      }
    },

    "people": {
      ".read": "auth != null",

      // Small, and rebuilt from each device. Losing it costs a few
      // names rather than a year of inspections.
      ".write": "auth != null"
    }
  }
}
