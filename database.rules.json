{
  "rules": {
    ".read": false,
    ".write": false,

    "records": {
      ".read": "auth != null",

      // No write on the collection itself, only on a record inside it.
      // That is what stops one call from deleting the whole service
      // history: a wipe would need one delete per record, not a single
      // PUT of null. The app only ever updates records/<id> paths.
      ".write": false,

      "$recordId": {
        ".write": "auth != null",

        // A record may only move FORWARD in time. Even if a tablet
        // holding an old copy tries to write it back, the database
        // refuses rather than quietly undoing someone's work. Equal is
        // allowed so an unchanged re-send is harmless, and a delete
        // (newData does not exist) is left to the .write rule above.
        ".validate": "newData.hasChildren(['id', 'type', 'docNo']) && (!data.exists() || !data.hasChild('updatedAt') || newData.child('updatedAt').val() >= data.child('updatedAt').val())",

        "id": { ".validate": "newData.val() === $recordId" }
      }
    },

    "people": {
      ".read": "auth != null",

      // Small, and rebuilt from each device. Losing it costs a few
      // names rather than a year of inspections.
      ".write": "auth != null"
    }
  }
}
